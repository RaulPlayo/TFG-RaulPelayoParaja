@startuml colaboracionVerNotificacion

title Diagrama de colaboracion - verNotificacion()

left to right direction

skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam linetype polyline
skinparam ArrowColor #222222
skinparam rectangle {
  BorderColor #666666
  RoundCorner 5
}

frame "verNotificacion()" {
  rectangle "Responsable" as responsable #FFFFFF
  rectangle "VistaHistorialNotificaciones" as vistaHistorial #6EA8FE
  rectangle "VistaNotificacion" as vistaNotificacion #6EA8FE
  rectangle "ControladorLecturaNotificacion" as controladorLectura #B7C85B
  rectangle "HistorialNotificaciones" as historial #F4A742
  rectangle "Notificacion" as notificacion #F4A742

  responsable --> vistaHistorial : verNotificacion(notificacionId)
  vistaHistorial --> controladorLectura : solicitarDetalle(notificacionId)
  controladorLectura --> historial : buscarNotificacion(notificacionId)
  historial --> notificacion : obtenerDatos()
  notificacion --> historial : datosNotificacion
  historial --> controladorLectura : detalleNotificacion
  controladorLectura --> historial : marcarComoLeida(notificacionId)
  historial --> notificacion : actualizarEstado(isRead=true)
  notificacion --> historial : estadoActualizado
  controladorLectura --> vistaNotificacion : mostrarDetalle(detalleNotificacion)
  vistaNotificacion --> responsable : notificacionVisible
}

rectangle ":HISTORIAL_ABIERTO" as historialAbierto #CDEFA6
rectangle ":NOTIFICACION_ABIERTA" as notificacionAbierta #CDEFA6

historialAbierto ..> notificacionAbierta : verNotificacion()
notificacionAbierta ..> historialAbierto : cerrarDetalle()

@enduml
